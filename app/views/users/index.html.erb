<div class="container">
<div class="row">
<%=render "layouts/menu" %>
<div class="col-md-5 mt-5">
<table>
<% @users.each do |user| %>
<tr>
<th class="border-bottom"><%=image_tag user.get_profile_image(50,50) %>
<%=link_to user.name,user_path(user) %><br>
<%=user.introduction%></th>
</tr>
<% end %>
</table>
</div>
</div>