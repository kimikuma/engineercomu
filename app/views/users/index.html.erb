<div class="container">
<div class="row">
<%=render "layouts/menu" %>
<div class="col-md-5 mt-5">
<taable>
<% @users.each do |user| %>
<tr class="border-bottom">
<p><%=image_tag user.get_profile_image(50,50) %>
