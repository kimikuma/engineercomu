<div class="container">
<div class="row">
<%=render "layouts/menu" %>
<div class="col-md-5 mt-5">
<%=image_tag @user.get_profile_image(70,70) %>
<%=@user.name %>
<%=@user.introduction %>
<% if @user==current_user %>
<% unless @user.guest_user? %>
<%=link_to edit_user_path(@user) do %>
<i class="fa-solid fa-user-pen"></i>
<% end %>
<% end %>
<% end %>
</div>
</div>
</div>