<div class="container">
  <div class="row">
    <div class="col-md-5 mt-5">
      <%=form_with model: @user do |f| %>
        <%=f.label:name %><br>
        <%=f.text_field:name,placeholder: "花子" %><br>
        <%=f.label:introduction %><br>
        <%=f.text_area:introduction,placeholder: "よろしく"%><br>
        <%=f.label:image %><br>
        <%=f.file_field:profile_image,accept: "image/*" %><br>
        <%=f.submit "更新" %>
      <% end %>
    </div>
  </div>
</div>