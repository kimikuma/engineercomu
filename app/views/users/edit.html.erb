<div class="container">
<div class="row">
  <div class="col-md-5 mt-5">
<%=form_with model: @user do |f| %>
<p><%=f.label:name %><br>
<%=f.text_field:name,placeholder: "花子" %></p>
<p><%=f.label:introduction %><br>
<%=f.text_area:introduction,placeholder: "よろしく"%></p>
<p><%=f.label:image %><br>
<%=f.file_field:profile_image,accept: "image/*" %></p>
<p><%=f.submit "更新" %></p>
<% end %>
</div>
</div>
</div>