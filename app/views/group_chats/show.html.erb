<div class="container">
  <div class="row">
    <%=render "layouts/menu" %>
    <div class="col-md-8" style="background-color:rgba(135,206,250,0.5); border-radius:20px; height:700px">
      <h3 class="mt-4"><%=@group.name %>room</h3>
      <div class="message" style="margin:10px auto;">
      <% @chats.each do |chat| %>
      <% if chat.user==current_user %>
      <%=render "group_chats/message",chat: chat,group: @group %>
      <% else %>
      <div class="left-container d-flex">
        <%=chat.user.get_profile_image(30,30),class: "rounded-circle" %>
        <%=chat.user.name %>
        <p id="chat<%=chat.id%>" style="background-color:rgba(230,230,250,0.6); border-radius:10px; padding:5px">
        <%=chat.message %>
        </p>
      </div>
      <% end %>
      <% end %>
    </div>
    <%=render "group_chats/form",group: @group %>
    </div>
  </div>
</div>