<div class="container">
  <div class="row">
    <%=render "layouts/menu" %>
    <div class="col-md-5 mt-5">
      <div class="content d-flex">
      <% @groups.each do |group| %>
     <div class="group_content  p-3 border border-primary ms-2" style="border-radius:10px; width:350px; height:300px; margin-right:20px">
        <p><%=image_tag group.get_group_image(300,200) %><br>
        <%=link_to group.name,group_path(group) %><br>
        <%=group.introduction %>
        <% unless group.owner_id==current_user.id %>
        <% if group.includesUser?(current_user) %>
        <%=link_to "Leave this group",group_group_users_path(group),method: :delete,class: "btn btn-danger" %>
        <% else %>
        <%=link_to "Join this group",group_group_users_path(group),method: :post,class: "btn btn-success" %>
        <% end %>
        <% end %>
       </div>
       <% end %>
       </div>
       <%=link_to new_group_path,class: "btn btn-warning mt-5" do %>
      <i class="fa-solid fa-plus"></i>
      <% end %>
    </div>

  </div>
</div>
